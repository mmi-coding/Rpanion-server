#!/bin/sh
# Setup system user
if ! getent passwd "rpanion" >/dev/null
then
    adduser --system --group --quiet rpanion
fi

sudo usermod -a -G plugdev rpanion
sudo usermod -a -G dialout rpanion
sudo usermod -a -G netdev rpanion
sudo usermod -a -G gpio rpanion
sudo usermod -a -G video rpanion
sudo usermod -a -G adm rpanion    # for systemd journal access
sudo usermod -a -G render rpanion   # for access to hardware video encoding on Jetson Orin
sudo usermod -a -G networkmanager rpanion   # for access to nmcli and dnsmasq leases

# Set up Python virtual environment
/usr/share/rpanion-server/app/python/setup-venv.sh

# Ensure the config dir exists (config/user.json is no longer shipped — the
# server self-provisions a random-password admin on first boot; see S1).
mkdir -p /etc/rpanion-server/config

# Set permissions
chown -R rpanion /usr/share/rpanion-server
chown -R rpanion /etc/rpanion-server
chown -R rpanion /etc/wireguard
chmod +x /usr/share/rpanion-server/app/server/index.js
systemctl daemon-reload
systemctl enable rpanion-server
systemctl start rpanion-server

# Allow relevant services to be disabled or enabled without password
cat <<'EOF' > /etc/sudoers.d/allow-vpn-control
rpanion ALL=(ALL) NOPASSWD: \
  /usr/bin/systemctl disable wg-quick@*, \
  /usr/bin/systemctl enable wg-quick@*, \
  /usr/bin/wg-quick down *, \
  /usr/bin/wg-quick up *, \
  /usr/bin/wg show *, \
  /usr/sbin/zerotier-cli join *, \
  /usr/sbin/zerotier-cli leave *, \
  /usr/sbin/zerotier-cli listnetworks *, \
  /usr/sbin/zerotier-cli info, \
  /usr/bin/tailscale status *, \
  /usr/bin/tailscale up *, \
  /usr/bin/tailscale down, \
  /usr/sbin/shutdown *, \
  /usr/bin/timedatectl set-timezone *, \
  /usr/bin/nmcli *, \
  /usr/sbin/pppd *, \
  /usr/bin/poff, \
  /usr/bin/qmicli *, \
  /usr/sbin/udhcpc *, \
  /usr/bin/ip link set *, \
  /usr/sbin/iw dev * scan ap-force, \
  /usr/bin/pkill -SIGTERM -f pppd*, \
  /usr/bin/cat /var/lib/NetworkManager/dnsmasq-*
EOF

chmod 440 /etc/sudoers.d/allow-vpn-control

# QMI modems (qmi_wwan): set raw-IP framing automatically when the interface
# appears, so the QMI data path is turnkey (SIM7600 etc. need raw_ip=Y).
cat <<'EOF' > /etc/udev/rules.d/77-rpanion-qmi-rawip.rules
ACTION=="add|change", SUBSYSTEM=="net", DRIVERS=="qmi_wwan", ATTR{qmi/raw_ip}="Y"
EOF
udevadm control --reload-rules 2>/dev/null || true
udevadm trigger --subsystem-match=net 2>/dev/null || true

# Keep NetworkManager from managing the modem's wwan0 (the app drives it via
# qmicli/udhcpc); otherwise NM fights the manual data call.
mkdir -p /etc/NetworkManager/conf.d
cat <<'EOF' > /etc/NetworkManager/conf.d/rpanion-wwan-unmanaged.conf
[keyfile]
unmanaged-devices=interface-name:wwan0
EOF
nmcli general reload 2>/dev/null || true


